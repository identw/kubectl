{
  "enabledManagers": ["dockerfile", "custom.regex"],
  "dockerfile": {
    "fileMatch": ["^Dockerfile_v\\d+\\.\\d+\\.x$"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^Dockerfile_v\\d+\\.\\d+\\.x$"],
      "matchStrings": [
        "https://dl\\.k8s\\.io/release/v(?<currentValue>\\d+\\.\\d+\\.\\d+)/bin/linux/amd64/kubectl"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "kubernetes/kubernetes",
      "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Group alpine base image updates across all Dockerfiles",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker.io/alpine", "alpine"],
      "groupName": "alpine base image"
    }
  ],
  "automerge": false
}
